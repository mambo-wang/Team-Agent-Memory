# TDAI memory-core standalone 部署 .env (172.53.4.202)
# LLM 参数占位，需用户自行补全 MEMORY_LLM_API_KEY / MODEL 后再重启

# ── memory-core ──
MEMORY_CORE_IMAGE=agentmemory/memory-core:latest
MEMORY_CORE_PORT=8420
MEMORY_CORE_VOLUME=tdai-memory-core-data

# ── LLM (memory 组，memory-core 内部 embed/summarize 用) ──
# 填入你的 OpenAI 兼容端点与 Key；留 REPLACE_ME 时容器可启动但抽取会失败
MEMORY_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEMORY_LLM_API_KEY=<REDACTED>
MEMORY_LLM_MODEL=qwen3.8-max
MEMORY_LLM_PROTOCOL=openai

# 可选覆盖
MEMORY_PROMPT_MODE=chat
MEMORY_CORE_GATEWAY_API_KEY=
MEMORY_CORE_ADMIN_USERNAME=admin

# ── 三件套补齐（Hub + Proxy）──────────────────────────────────────────────
MEMORY_HUB_IMAGE=agentmemory/memory-hub:latest
PROXY_IMAGE=agentmemory/memory-proxy:latest
PANEL_PORT=8125
KNOWLEDGE_PORT=8424
PROXY_PORT=8096
PANEL_VOLUME=tdai-panel-data
KNOWLEDGE_PUBLIC_BASE_URL=http://host.docker.internal:8424/v3
MEMORY_HUB_PROXY_PUBLIC_URL=http://172.53.4.202:8096

# ── proxy 组：上游 LLM（coding agent 请求经 proxy 转发到这里）──────────────
# TODO: 填入你的上游 LLM 真值（与 memory 组可不同）
PROXY_UPSTREAM_URL=https://api.deepseek.com/v1
PROXY_UPSTREAM_API_KEY=<REDACTED>
PROXY_UPSTREAM_MODEL=deepseek-v4-flash
PROXY_ENABLE_TDAI=1

# ── Embedding (qwen3.7-text-embedding via dashscope OpenAI-compatible) ──
MEMORY_EMBEDDING_PROVIDER=openai
MEMORY_EMBEDDING_MODEL=qwen3.7-text-embedding
MEMORY_EMBEDDING_DIMENSIONS=1024

# 一键开启 auth + tdai + session-init（让真实身份经 auth/verify 生效，而非匿名兜底）
PROXY_FULL_STACK=1
PROXY_ENABLE_AUTH=1
PROXY_ENABLE_SESSION_INIT=1
